// =====================================================================
//  ToxicBots — НАСТРОЙКИ. Меняй числа, сохраняй, перезапускай карту.
//  Вероятности: 0.0 = никогда, 1.0 = всегда.
// =====================================================================
::TB_CFG <- {
	enabled              = true,   // мод включён (в чате: !tb off / !tb on)

	// --- характер ботов
	toxicity             = 0.5,    // 0 — почти все душки, 1 — все токсики (в чате: !tb toxic 0.3)
	start_respect        = 50,     // отношение к тебе в начале (0..100). Хамишь — падает, нормально общаешься и играешь — растёт
	peace_time           = 150.0,  // сек. боты добрее после «давайте быть командой»
	good_round_chance    = 0.6,    // шанс, что заметят твой хороший раунд (2+ кила)

	// --- приказы («за мной», «прикройте», «дефузьте»...)
	obey_enabled         = true,   // боты-тиммейты реально выполняют приказы (радио-команды игры)
	radio_feedback       = true,   // проиграть тебе звук радио и показать «(Радио) Ты: За мной!»

	// --- живость
	humanize             = true,   // иногда с маленькой буквы, без точки, в два сообщения, с опечаткой и «*исправлением»
	typo_chance          = 0.04,   // шанс опечатки
	banter_chance        = 0.2,    // после ответа другой бот подъёбывает ответившего, и они срутся
	bot_kill_bot_chance  = 0.12,   // бот убил бота — подкол / нытьё
	troll_enabled        = true,   // один бот — тролль: угорает, когда ты обсираешь других
	troll_chance         = 0.45,   // ... шанс, что он подхватит твой наезд на другого бота
	troll_joke_chance    = 0.2,    // ... шутка в конце раунда
	accuse_enabled       = true,   // «ты с читами?» — 3 хедшота подряд, 3+ кила за раунд, эйс
	aim_bad_chance       = 0.35,   // ноль урона за раунд — подкол про аим

	// --- оружие, дуэли, кики
	drop_distance        = 800.0,  // дальше этого бот скажет «подойди» и скинет, когда подойдёшь
	duel_scope           = "all",  // "all" — дуэль для всех ботов (+ квоты bot_allow_*), "enemy" — только противники
	duel_start_window    = 35.0,   // сек. от начала раунда, пока дуэль начинается сразу (иначе со следующего)
	duel_offer_chance    = 0.07,   // боты сами предлагают «го раунд на ножах» (ответь «да» / «нет»)
	server_commands      = true,   // разрешить скрипту серверные команды (кик бота, bot_allow_*)
	kick_enabled         = true,   // реально кикать бота, если проголосовали
	kick_talk            = true,   // боты сами предлагают кикнуть худшего / тебя

	// --- чит-панель ToxicHack (в чате: !c) — только для игры с ботами
	cheats_enabled       = true,   // разрешить панель
	cheat_god_hp         = 5000,   // хп при «бессмертии» (боты видят, что попадают, а ты не умираешь)
	cheat_speed          = 1.8,    // множитель скорости спидхака
	cheat_decay          = 0.8,    // на сколько % в секунду спадает подозрение, когда читы выключены
	cheat_stage_min      = 12.0,   // сек. минимум между стадиями (удивление -> обвинения -> свои против -> хоровод)
	cheat_dance_time     = 20.0,   // сек. хоровода вокруг читера
	cheat_attack_time    = 30.0,   // сек. общей атаки между хороводами

	reply_chance         = 1.0,    // шанс, что боты ответят на твоё сообщение
	enemy_share          = 0.65,   // доля ответов от противников (остальное — тиммейты)
	pile_chance          = 0.25,   // шанс, что второй бот подхватит и добавит
	classic_chance       = 0.55,   // шанс ответить "классикой", если фраза похожа на готовую
	classic_exact_chance = 0.8,    // ... если совпала почти дословно
	pre_chance           = 0.25,   // шанс приставки "Блять, ...", "Сука, ..."
	pre_chance_mat       = 0.5,    // ... если ты сам материшься
	post_chance          = 0.2,    // шанс добивки "... лол", "... изи"
	kill_taunt_chance    = 0.45,   // бот убил тебя — подкалывает
	death_whine_chance   = 0.35,   // ты убил бота — он ноет
	first_death_chance   = 0.5,    // ты умер первым в раунде — тиммейт комментирует
	round_talk_chance    = 0.75,   // "бляя проебали раунд" в конце раунда
	worst_chance         = 0.6,    // разбор худшего игрока раунда
	worst_reply_chance   = 0.7,    // худший бот огрызается в ответ
	map_start_chance     = 0.6,    // приветствие в начале карты
	typing_speed         = 10.0,   // букв в секунду "печатает" бот (задержка ответа)
	typing_max           = 5.5,    // ... но не дольше стольких секунд
	read_speed           = 18.0,   // букв в секунду "читает" бот чужое сообщение, прежде чем ответить
	chat_gap             = 1.2,    // мин. пауза (сек) между сообщениями разных ботов
	chat_max_delay       = 30.0,   // реплики, которые пришлось бы ждать дольше, не говорятся (не спамят в следующем раунде)
	voice_enabled        = true,   // читать распознанный голос (voice/ГОЛОС.bat)
	voice_file           = "toxicbots_voice.txt",  // cstrike/scriptdata/<файл>
	voice_echo           = true,   // показывать тебе "[голос] что распознано"
	voice_poll           = 0.25,   // как часто проверять файл голоса (сек). Слабый ПК — можно 0.5
	clips_enabled        = true,   // готовые озвученные фразы (sound/toxicbots/*.wav) прямо в игре
	clips_volume         = 1.0,
	tts_enabled          = true,   // живая озвучка всех ответов (нужна запущенная voice/ЗАПУСТИТЬ_ГОЛОС.bat)
	tts_file             = "toxicbots_tts.txt",    // cstrike/scriptdata/<файл>
	debug                = false   // писать в консоль, какой интент сработал
}
