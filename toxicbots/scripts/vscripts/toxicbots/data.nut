  [[1076,1072,32,1085,1091,32,1090,1077,1073,1103], "Ну меня — ты же первый в чат зашёл. Я отвечаю."],
  [[1076,1072,32,1073,1083,1103,1090,1100,32,1085,1091,32,1090,1077,1073,1103], "Блять, ну меня — ты же первый в чат зашёл. Я отвечаю."],
  [[1076,1072,32,1080,1076,1080,32,1090,1099,32,1085,1072,1093,1091,1081,32,1073,1083,1103,1090,1100], "Блять, иду. Но сначала досмотрю, как ты сливаешь клатч."],
  [[1076,1072,32,1087,1086,1096,1077,1083,32,1090,1099,32,1085,1072,1093,1091,1081,32,1073,1083,1103,1090,1100], "Блять, пошёл и вернулся с инфой: ты опять умер первым."],
  [[1076,1072,32,1085,1091,32,1090,1077,1073,1103,32,1085,1072,1093,1091,1081,32,1073,1083,1103,1090,1100], "Блять, нахуй — это твой маршрут на респавн. Ты туда каждый раунд."],
  [[1076,1072,32,1073,1083,1103,1090,1100,32,1080,1076,1080,32,1090,1099,32,1085,1072,1093,1091,1081,32,1086,1073,1098,1103,1089,1085,1080], "Объясняю: ты пикнул без смока и умер. Вот и иди ты нахуй."],
  [[1076,1072,32,1080,1076,1080,32,1090,1099,32,1086,1073,1098,1103,1089,1085,1080], "Объясняю: ты в 1v5 купил декой. Вот и иди ты."],
  [[1076,1072,32,1087,1086,1096,1077,1083,32,1090,1099,32,1086,1073,1098,1103,1089,1085,1080], "Объясняю: ты в 0-15. Вот и пошёл ты."],
  [[1076,1072,32,1085,1091,32,1090,1077,1073,1103,32,1086,1073,1098,1103,1089,1085,1080], "Объясняю: ты в чате орёшь, а в игре молчишь. Вот и ну тебя."],
  [[1076,1072,32,1073,1083,1103,1090,1100,32,1080,1076,1080,32,1090,1099,32,1086,1073,1098,1103,1089,1085,1080], "Блять, объясняю: ты пикнул без смока и умер. Вот и иди ты."],
  [[1076,1072,32,1073,1083,1103,1090,1100,32,1087,1086,1096,1077,1083,32,1090,1099,32,1086,1073,1098,1103,1089,1085,1080], "Блять, объясняю: ты в 1v5 купил декой. Вот и пошёл ты."],
  [[1076,1072,32,1073,1083,1103,1090,1100,32,1085,1091,32,1090,1077,1073,1103,32,1086,1073,1098,1103,1089,1085,1080], "Блять, объясняю: ты в 0-15. Вот и ну тебя."],
  [[1076,1072,32,1080,1076,1080,32,1090,1099,32,1085,1072,1093,1091,1081,32,1072], "Иду. Ты останься — тебе ещё рейтинг терять."],
  [[1076,1072,32,1087,1086,1096,1077,1083,32,1090,1099,32,1085,1072,1093,1091,1081,32,1072], "Пошёл и вернулся с инфой: ты опять умер первым."],
  [[1090,1099,32,1095,1077,32,1090,1091,1087,1086,1081], "Тупой — тот, кто не слышит шаги. Ты же в наушниках?"],
  [[1090,1099,32,1095,1077,32,1085,1077,32,1087,1086,1085,1080,1084,1072,1077,1096,1100], "Понимаю — ты в 0-15. Вот и всё."],
  [[1090,1099,32,1095,1077,32,1075,1083,1091,1093,1086,1081], "Глухой — тот, кто не слышит шаги. Ты же в наушниках?"],
  [[1090,1099,32,1095,1077,32,1089,1083,1077,1087,1086,1081], "Слепой — тот, кто стреляет в смок. Ты же это делаешь?"],
  [[1090,1099,32,1095,1077,32,1090,1091,1087,1086,1081,32,1073,1083,1103,1090,1100], "Блять, тупой — тот, кто не слышит шаги. Ты же в наушниках?"],
