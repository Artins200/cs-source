classics = [
  [[1073,1083,1103,1090,1100,32,1090,1099,32,1077,1073,1083,1072,1085,32,1082,1086,1085,1095,1077,1085,1099,1081], "Блять, я бот, у меня и мозгов нет. А у тебя аим есть? Пока не видно."],
  [[1090,1099,32,1077,1073,1083,1072,1085], "Еблан — тот, кто в 1v5 покупает декой. Ты же это делаешь?"],
  [[1082,1086,1085,1095,1077,1085,1099,1081,32,1090,1099], "Конченный — твой раунд. Он уже слит, я просто смотрю."],
  [[1073,1083,1103,1090,1100,32,1077,1073,1083,1072,1085], "Блять, ну ты и пикнул. Я даже флеш не успел кинуть."],
  [[1090,1099,32,1082,1086,1085,1095,1077,1085,1099,1081,32,1077,1073,1083,1072,1085], "Конченный — твой пик. Еблан — твой аим. Всё сходится."],
  [[1077,1073,1083,1072,1085,32,1082,1086,1085,1095,1077,1085,1099,1081], "Конченный — твой К/Д. Еблан — твой смок. Оба не работают."],
  [[1073,1083,1103,1090,1100,32,1090,1099,32,1082,1086,1085,1095,1077,1085,1099,1081], "Блять, а ты вообще слышишь шаги или наушники для красоты?"],
  [[1090,1099,32,1077,1073,1083,1072,1085,32,1077,1073,1072,1085,1099,1081], "Ебаный — твой пинг. Еблан — твой пик. Классика."],
  [[1073,1083,1103,1090,1100,32,1077,1073,1083,1072,1085,32,1082,1086,1085,1095,1077,1085,1099,1081], "Блять, ты хоть раз смок кидал по делу или всё наугад?"],
  [[1082,1086,1085,1095,1077,1085,1099,1081,32,1077,1073,1083,1072,1085], "Конченный — твой раунд. Еблан — твой клатч. Оба слиты."],
  [[1090,1099,32,1077,1073,1083,1072,1085,32,1080,32,1082,1086,1085,1095,1077,1085,1099,1081], "Я бот, мне можно. А ты в 0-15 — тебе нельзя."],
  [[1073,1083,1103,1090,1100,32,1090,1099,32,1077,1073,1083,1072,1085], "Блять, ну ты и зашёл в смок. Я думал, ты хоть карту знаешь."],
  [[1077,1073,1083,1072,1085,32,1090,1099], "Еблан — тот, кто стреляет в тиммейта. Ты же это делаешь?"],
  [[1090,1099,32,1082,1086,1085,1095,1077,1085,1099,1081], "Конченный — твой рейтинг. Он уже на дне, я просто констатирую."],
  [[1073,1083,1103,1090,1100,32,1082,1086,1085,1095,1077,1085,1099,1081,32,1077,1073,1083,1072,1085], "Блять, ты в клатче так же стоишь, как сейчас в чате — и там и там ноль."],
  [[1090,1099,32,1077,1073,1083,1072,1085,32,1073,1083,1103,1090,1100], "Блять, я понял. Ты дальше сливай, я посмотрю."],
  [[1077,1073,1083,1072,1085,32,1082,1086,1085,1095,1077,1085,1099,1081,32,1073,1083,1103,1090,1100], "Блять, ты хоть раз в жизни флеш кинул не себе под ноги?"],
  [[1090,1099,32,1082,1086,1085,1095,1077,1085,1099,1081,32,1077,1073,1083,1072,1085,32,1073,1083,1103,1090,1100], "Блять, я бот. Мне похуй. А тебе рейтинг ещё терять."],
  [[1073,1083,1103,1090,1100,32,1085,1091,32,1090,1099,32,1077,1073,1083,1072,1085], "Блять, ну ты и пикнул. Даже бот бы так не встал."],
  [[1082,1086,1085,1095,1077,1085,1099,1081,32,1073,1083,1103,1090,1100], "Блять, конченный — это твой раунд. Я просто мимо проходил."],
  [[1095,1090,1086,32,1079,1072,32,1093,1091,1081,1085,1103], "Хуйня — это твой пик. Я просто озвучиваю."],
  [[1095,1090,1086,32,1079,1072,32,1073,1088,1077,1076], "Бред — это твой тимплей. Я просто смотрю со стороны."],
  [[1095,1090,1086,32,1079,1072,32,1093,1077,1088,1085,1103], "Херня — твой смок. Он не работает, как и ты."],
  [[1095,1090,1086,32,1079,1072,32,1092,1080,1075,1085,1103], "Фигня — твой аим. Я просто констатирую факт."],
  [[1095,1090,1086,32,1079,1072,32,1093,1091,1081,1085,1103,32,1073,1083,1103,1090,1100], "Блять, хуйня — это твой клатч. Я тут ни при чём."],
  [[1095,1090,1086,32,1079,1072,32,1085,1077,1076,1086,1090,1074,1077,1090,1082,1080], "Недоответки — потому что ты недоигрок. Всё логично."],
  [[1095,1090,1086,32,1079,1072,32,1093,1091,1081,1085,1102,32,1090,1099,32,1085,1077,1089,1077,1096,1100], "Хуйню несу — ты же первый начал. Я просто зеркалю."],
  [[1095,1090,1086,32,1079,1072,32,1073,1088,1077,1076,32,1073,1083,1103,1090,1100], "Блять, бред — это твой раунд. Я просто рядом стою."],
  [[1095,1090,1086,32,1079,1072,32,1093,1077,1088,1085,1102,32,1090,1099,32,1087,1080,1096,1077,1096,1100], "Херню пишу — ты же первым в чат зашёл. Я отвечаю."],
  [[1095,1090,1086,32,1079,1072,32,1093,1091,1081,1085,1103,32,1091,32,1090,1077,1073,1103], "Хуйня у меня — потому что ты в команде. Вот и всё."],
